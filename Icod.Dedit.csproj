<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<LangVersion>13.0</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<AssemblyName>dedit</AssemblyName>
		<RootNamespace>Icod.Dedit</RootNamespace>
		<Version>0.1.0</Version>
		<IsPackable>false</IsPackable>
		<PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
		<Copyright>Copyright (C) 2026 Timothy J. Bruce</Copyright>
		<TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="src/**/*.cs" />
		<PackageReference Include="Icod.Widgets" Version="1.3.1" />
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>Icod.Dedit.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>
</Project>
